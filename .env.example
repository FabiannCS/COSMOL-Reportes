

# Base de datos PostgreSQL (Servicio db en docker-compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=cosmol_reportes
DB_USER=admin
DB_PASSWORD=CAMBIAR_ESTA_CONTRASEÑA_EN_PRODUCCION

# Configuración de Entorno de Aplicación
# En producción: APP_ENV=production, APP_DEBUG=false
APP_PORT=8081
APP_ENV=production
APP_DEBUG=false

# APIs Externas (Servidor de Trabajos: Reconexiones y Reclamos)
API_RECONEXIONES_URL=http://api.cosmol.com.bo/api-consultas
API_RECLAMOS_URL=http://api.cosmol.com.bo/api-consultas
API_FOTOS_URL=https://chatbot.cosmol.com.bo

# Token Secreto de Autenticación para Integración Chatbot <-> Reportes
REPORTES_API_TOKEN=GENERAR_TOKEN_UNICO_Y_SEGURO_AQUI
